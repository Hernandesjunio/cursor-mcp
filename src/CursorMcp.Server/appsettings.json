{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://localhost:7071"
      }
    }
  },
  "SpikeAuth": {
    "PublicBaseUrl": "https://localhost:7071",
    "SigningKey": "spike-demo-hmac-key-32-bytes-min!!",
    "AccessTokenMinutes": 15,
    "AuthorizationCodeMinutes": 5,
    "RefreshTokenDays": 7,
    "Scope": "mcp:tools",
    "DemoUser": "demo-user",
    "Clients": [
      {
        "ClientId": "cursor-mcp-spike",
        "Name": "Cursor MCP Spike",
        "RedirectUris": [
          "http://127.0.0.1:9999/callback",
          "http://localhost:9999/callback",
          "http://127.0.0.1:9999/oauth/callback",
          "http://localhost:9999/oauth/callback",
          "https://www.cursor.com/agents/mcp/oauth/callback",
          "cursor://anysphere.cursor-mcp/oauth/callback"
        ]
      }
    ]
  }
}
