{
  "mcpServers": {
    "cursor-mcp-spike": {
      "command": "${env:NODE22_ABSOLUTE_PATH}",
      "args": [
        "${workspaceFolder}/tools/mcp-http-bridge/dist/mcp-http-bridge.js",
        "--config",
        "${workspaceFolder}/.cursor/mcp-bridge.json"
      ],
      "env": {
        "NODE_EXTRA_CA_CERTS": "${workspaceFolder}/certs/localhost.pem"
      }
    }
  }
}
